+;  irq_brk: the timer interrupt services the job queue (see job_scan); a BRK
+;  (no timer flag) just returns, as before.
 irq_brk:
+    pha
+    txa
+    pha
+    tya
+    pha
+    lda VIA2_IFR
+    and #$40
+    beq @out
+    lda VIA2_T1CL               ; acknowledge
+    lda job_busy
+    bne @out                    ; a job is under way: no re-entry
+    inc job_busy
+    jsr job_scan
+    lda #$00
