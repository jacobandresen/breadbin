+; ----------------------------------------------------------------------------
+;  Job queue (added for breadbin). The 1541's documented interface for code
+;  running in the drive: job codes at $00-$04 for buffers 0-4 ($0300-$07FF),
+;  track and sector at $06+2n/$07+2n. The DOS carries them out from its timer
+;  interrupt and leaves the result in place ($01 OK, $02 header not found, $05
+;  checksum). Fast loaders read sectors this way. READ ($80), SEEK ($B0), BUMP
+;  ($C0), JUMP ($D0) and EXECUTE ($E0) are done; WRITE ($90) and VERIFY ($A0)
+;  answer OK without writing. The code that set the jobs owns the zero page, so
+;  what the disk routines use of it ($12-$2C) is saved around each job.
+; ----------------------------------------------------------------------------
+JOB_ZP    = $12           ; what the disk routines use: $12-$2C
+JOB_ZPLEN = $2C - $12 + 1
+JOB_SAVE  = $0146         ; the saved zero page ($0146-$0160)
+job_busy  = $0161
+job_n     = $0162
+job_si    = $0163         ; 2 bytes: GCR byte read next
+job_k     = $0165         ; 2 bytes: decoded byte written next
+job_j     = $0167
+job_mark  = $0168
+job_sum   = $0169
+job_byte  = $016A
+job_jmp   = $016B         ; 2 bytes
+f50a_tpl  = $016D         ; 5 bytes: the header looked for, raw GCR
+f50a_tries = $0172
+JOB_OVF   = $01BA         ; GCR beyond the buffer's first 256 bytes, as on a 1541
+;  Drive code may use the whole stack page as a buffer, so what must outlive
+;  it is kept where the 1541 DOS keeps it: the job running in $3F, the stack
+;  pointer to return to in $49.
+JOB_CUR   = $3F
+JOB_SP    = $49
+;  ...and the head's track in $22, which loaders that step the head set too.
+JOB_TRACK = JOB_SAVE + $22 - JOB_ZP
+
+
+;  job_start: the timer interrupt, every 10 ms, and interrupts on.
+job_start:
+    lda #$00
+    sta job_busy
+    lda #$41                    ; T1 free-running, port A still latched
+    sta VIA2_ACR
+    lda #<10000
+    sta VIA2_T1CL
+    lda #>10000
+    sta VIA2_T1CH
+    lda #$C0                    ; T1 interrupt on
+    sta VIA2_IER
+    cli
+    rts
+
+job_scan:
+    ldx #$00
+js_next:
+    lda $00,x
+    bpl js_skip
+    stx job_n
+    and #$F0
+    cmp #$D0
+    beq js_jump
+    cmp #$E0
+    bne js_dos
+    jsr job_save_zp             ; EXECUTE: put the head there, then run the buffer
+    ldx job_n
+    jsr job_head
+    jsr job_restore_zp
+js_jump:
+    lda job_n
+    sta JOB_CUR
+    clc
+    adc #$03
+    sta job_jmp+1
+    lda #$00
+    sta job_jmp
+    tsx
+    stx JOB_SP
+    jsr js_go
+job_scan_resume:
+    ldx JOB_CUR
+    stx job_n
+    cmp #$01                    ; the result it left in A, or OK
+    bcc js_ok
+    cmp #$80
+    bcc js_done
+js_ok:
+    lda #$01
+    bne js_done
+js_go:
+    jmp (job_jmp)
+js_dos:
+    jsr job_save_zp
+    ldx job_n
+    jsr job_run
+    pha
+    jsr job_restore_zp
+    pla
+js_done:
+    ldx job_n
+    sta $00,x
+js_skip:
+    inx
+    cpx #5
+    bne js_next
+    rts
+
+; ----------------------------------------------------------------------------
+;  Entry points that drive code calls by address (added for breadbin), placed
+;  where the 1541's documented ones are (segments F50A and F969 in the linker
+;  configuration): code a job runs (JUMP/EXECUTE) uses them to read a sector.
+; ----------------------------------------------------------------------------
+;  compat_f50a: find the header of the job's sector on the current track, then
+;  wait for its data block: the next GCR byte read (BVC loop) is the block's
+;  first. The search compares raw GCR and uses no zero page, so the code that
+;  called it keeps its own.
+compat_f50a:
+    ldx JOB_CUR
+    stx job_n
+    jsr job_save_zp
+    ldx job_n
+    txa
+    asl a
+    tay
+    lda $0006,y
+    sta want_track
+    lda $0007,y
+    sta want_sector
+    lda #MAX_TRIES
+    sta dsk_tries
+@idtry:
+    jsr disk_wait_sync
+    bcs @nohdr
+    jsr disk_read10
+    lda RAW_BUF
+    cmp #$52
+    bne @idnext
+    lda #<RAW_BUF
+    sta gcr_src
+    lda #>RAW_BUF
+    sta gcr_src+1
+    jsr disk_read_header
+    lda hdr_error
+    beq @gotid
+@idnext:
+    dec dsk_tries
+    bne @idtry
+@nohdr:
+    jsr job_restore_zp
+    jmp @fail
+@gotid:
+    lda HEADER_BUF+5
+    sta want_id1
+    lda HEADER_BUF+4
+    sta want_id2
+    lda #<HDR_TPL
+    sta gcr_dst
+    lda #>HDR_TPL
+    sta gcr_dst+1
+    jsr disk_build_header
+    ldx #4
+@cp:
+    lda HDR_TPL,x
+    sta f50a_tpl,x
+    dex
+    bpl @cp
+    jsr job_restore_zp
+    lda #MAX_TRIES
+    sta f50a_tries
+@try:
+    jsr disk_wait_sync
+    bcs @fail
+    jsr disk_read10
+    ldx #4
+@cmp:
+    lda RAW_BUF,x
+    cmp f50a_tpl,x
+    bne @next
+    dex
+    bpl @cmp
+@data:
+    bit VIA2_PB                 ; the data block's SYNC
+    bmi @data
+    clv
+    rts
+@next:
+    dec f50a_tries
+    bne @try
+@fail:
+    lda #$02                    ; header not found: the job ends with 20
+    jmp compat_f969
+
+;  compat_d042: initialise the drive as the 1541's "I" does for code started
+;  by M-E (Krill's loader calls it): the head to track 18; the disk ID into
+;  $12/$13, the header read into $16-$1A (ID, track, sector, checksum) and
+;  the head's track into $22, where loaders compare and step from.
+compat_d042:
+    jsr job_save_zp
+    lda #18
+    sta want_track
+    lda JOB_TRACK
+    beq @find
+    sta cur_track
+@find:
+    jsr disk_find_current_track
+    jsr disk_seek
+    jsr disk_set_speed_zone
+    jsr disk_read_hdr_retry
+    lda cur_track
+    sta JOB_TRACK
+    jsr job_restore_zp
+    lda HEADER_BUF+5
+    sta $12
+    sta $16
+    lda HEADER_BUF+4
+    sta $13
+    sta $17
+    lda HEADER_BUF+3
+    sta $18
+    lda HEADER_BUF+2
+    sta $19
+    lda HEADER_BUF+1
+    sta $1A
+    lda #$01
+    rts
+
+;  compat_d586: read the sector of job $F9 into its buffer and wait for it,
+;  for code started by M-E (Spindle's bootstrap reads the rest of its drive
+;  code this way). Returns the job's result in A.
+compat_d586:
+    ldx $F9
+    lda #$80
+    sta $00,x
+    cli
+@wait:
+    lda $00,x
+    bmi @wait
+    rts
+
+;  compat_f969: end the running job with the result in A, back to the queue.
+compat_f969:
+    ldx JOB_SP
+    txs
+    jmp job_scan_resume
+
+job_save_zp:
+    ldx #JOB_ZPLEN - 1
+@l:
+    lda JOB_ZP,x
+    sta JOB_SAVE,x
+    dex
+    bpl @l
+    rts
+
+job_restore_zp:
+    ldx #JOB_ZPLEN - 1
+@l:
+    lda JOB_SAVE,x
+    sta JOB_ZP,x
+    dex
+    bpl @l
+    rts
+
+;  job_run: job n (X) with the DOS's zero page; returns the result in A.
+job_run:
+    lda $00,x
+    and #$F0
+    cmp #$80
+    beq job_read
+    cmp #$B0
+    bne @ok
+    jsr job_head                ; SEEK
+@ok:
+    lda #$01
+    rts
+
+;  job_head: the head to job n's track (X), motor on.
+job_head:
+    txa
+    asl a
+    tay
+    lda $0006,y
+    sta want_track
+    lda $0007,y
+    sta want_sector
+    lda JOB_TRACK
+    beq @find
+    sta cur_track
+@find:
+    jsr disk_find_current_track
+job_reseek:
+    jsr disk_seek
+    jsr disk_set_speed_zone
+    lda cur_track
+    sta JOB_TRACK
+    rts
+
+;  job_read: job n's sector into buffer n, decoded in place (the data block's
+;  GCR is read into the buffer, the 69 bytes beyond it into JOB_OVF).
+job_read:
+    stx job_n
+    jsr job_head
+    lda #$00
+    sta dsk_ptr
+    lda job_n
+    clc
+    adc #$03
+    sta dsk_ptr+1
+    lda #MAX_TRIES
+    sta dsk_tries
+@try:
+    jsr disk_wait_sync
+    bcs @fail
+    jsr disk_read10
+    lda RAW_BUF
+    cmp #$52                    ; a header's first GCR byte
+    bne @next
+    jsr disk_wait_sync
+    bcs @fail
+    jsr job_read_block
+    lda #<RAW_BUF
+    sta gcr_src
+    lda #>RAW_BUF
+    sta gcr_src+1
+    jsr disk_read_header
+    lda hdr_error
+    bne @next
+    lda hdr_track
+    cmp want_track
+    beq @track
+    sta cur_track               ; the head is elsewhere: go again
+    jsr job_reseek
+    jmp @next
+@track:
+    lda hdr_sector
+    cmp want_sector
+    bne @next
+    jsr job_decode
+    lda data_error
+    bne @bad
+    lda #$01
+    rts
+@next:
+    dec dsk_tries
+    bne @try
+@fail:
+    lda #$02
+    rts
+@bad:
+    lda #$05
+    rts
+
+job_read_block:
+    ldy #$00
+    clv
+@r1:
+    bvc @r1
+    clv
+    lda VIA2_PA
+    sta (dsk_ptr),y
+    iny
+    bne @r1
+    ldy #$00
+@r2:
+    bvc @r2
+    clv
+    lda VIA2_PA
+    sta JOB_OVF,y
+    iny
+    cpy #(325-256)
+    bne @r2
+    rts
+
+;  job_decode: 65 groups of 5 GCR bytes -> the data mark, 256 bytes into the
+;  buffer and the checksum. The output trails the input, so in place is safe.
+job_decode:
+    lda #$00
+    sta job_si
+    sta job_si+1
+    sta job_k
+    sta job_k+1
+    sta dsk_csum
+    lda #65
+    sta dsk_count
+@group:
+    ldx #$00
+@ld:
+    jsr job_get
+    sta gcr_o,x
+    inx
+    cpx #5
+    bne @ld
+    lda #4
+    sta job_j
+@out:
+    jsr gcr_get_nibble
+    asl a
+    asl a
+    asl a
+    asl a
+    sta gcr_tmp
+    jsr gcr_get_nibble
+    ora gcr_tmp
+    jsr job_emit
+    dec job_j
+    bne @out
+    dec dsk_count
+    bne @group
+    lda job_mark
+    cmp #DATA_MARK
+    bne @bad
+    lda dsk_csum
+    cmp job_sum
+    bne @bad
+    lda #$00
+    sta data_error
+    rts
+@bad:
+    lda #$FF
+    sta data_error
+    rts
+
+job_get:
+    ldy job_si
+    lda job_si+1
+    bne @ovf
+    lda (dsk_ptr),y
+    jmp @inc
+@ovf:
+    lda JOB_OVF,y
+@inc:
+    inc job_si
+    bne @r
+    inc job_si+1
+@r:
+    rts
+
+job_emit:
+    sta job_byte
+    lda job_k+1
+    bne @hi
+    lda job_k
+    beq @mark
+    tay
+    dey
+    lda job_byte
+    sta (dsk_ptr),y
+    eor dsk_csum
+    sta dsk_csum
+    jmp @inc
+@mark:
+    lda job_byte
+    sta job_mark
+    jmp @inc
+@hi:
+    lda job_k
+    bne @sum
+    ldy #$FF                    ; byte 256: the buffer's last
+    lda job_byte
+    sta (dsk_ptr),y
+    eor dsk_csum
+    sta dsk_csum
+    jmp @inc
+@sum:
+    cmp #1
+    bne @inc
+    lda job_byte
+    sta job_sum
+@inc:
+    inc job_k
+    bne @r
+    inc job_k+1
+@r:
+    rts
+
