+    cmp #31
+    bcc @z1
+    lda #17
+    rts
+@z1:
+    lda #18
+    rts
+@z2:
+    lda #19
+    rts
+@z3:
+    lda #21
+    rts
+
+;  job_start: the timer interrupt, every 10 ms, and interrupts on.
+job_start:
+    lda #$00
+    sta job_busy
+    lda #$41                    ; T1 free-running, port A still latched
+    sta VIA2_ACR
+    lda #<10000
+    sta VIA2_T1CL
+    lda #>10000
+    sta VIA2_T1CH
+    lda #$C0                    ; T1 interrupt on
+    sta VIA2_IER
+    cli
+    rts
+
+job_scan:
+    ldx #$00
+js_next:
+    lda $00,x
+    bpl js_skip
+    stx job_n
+    and #$F0
+    cmp #$D0
+    beq js_jump
+    cmp #$E0
+    bne js_dos
+    jsr job_save_zp             ; EXECUTE: put the head there, then run the buffer
+    ldx job_n
+    jsr job_head
+    jsr job_restore_zp
+    ;  (breadbin) and the number of sectors on that track in $43, as a 1541's
+    ;  job loop leaves it: Creatures II's NOSDOS V1.8 counts the sectors of a
+    ;  track down from $43 as it scans the track for its files.
+    lda job_n
+    asl a
+    tax
+    lda $06,x
+    jsr job_sectors
+    sta $43
+js_jump:
+    lda job_n
+    sta JOB_CUR
+    clc
+    adc #$03
+    sta job_jmp+1
+    lda #$00
+    sta job_jmp
+    tsx
+    stx JOB_SP
+    jsr js_go
+job_scan_resume:
+    ldx JOB_CUR
+    stx job_n
+    cmp #$01                    ; the result it left in A, or OK
+    bcc js_ok
+    cmp #$80
+    bcc js_done
+js_ok:
+    lda #$01
+    bne js_done
+js_go:
+    jmp (job_jmp)
+js_dos:
+    jsr job_save_zp
+    ldx job_n
+    jsr job_run
+    pha
+    jsr job_restore_zp
+    pla
+js_done:
+    ldx job_n
+    sta $00,x
+js_skip:
+    inx
+    cpx #5
+    bne js_next
+    rts
+
+; ----------------------------------------------------------------------------
+;  Entry points that drive code calls by address (added for breadbin), placed
+;  where the 1541's documented ones are (segments F50A and F969 in the linker
+;  configuration): code a job runs (JUMP/EXECUTE) uses them to read a sector.
+; ----------------------------------------------------------------------------
+;  compat_f50a: find the header of the job's sector on the current track, then
+;  wait for its data block: the next GCR byte read (BVC loop) is the block's
+;  first, and Y = 0. The search compares raw GCR and uses no zero page, so the code that
+;  called it keeps its own.
+compat_f50a:
+    ldx JOB_CUR
+    stx job_n
+    jsr job_save_zp
+    ldx job_n
+    txa
+    asl a
+    tay
+    lda $0006,y
+    sta want_track
+    lda $0007,y
+    sta want_sector
+    lda #MAX_TRIES
+    sta dsk_tries
+@idtry:
+    jsr disk_wait_sync
+    bcs @nohdr
+    jsr disk_read10
+    lda RAW_BUF
+    cmp #$52
+    bne @idnext
+    lda #<RAW_BUF
+    sta gcr_src
+    lda #>RAW_BUF
+    sta gcr_src+1
+    jsr disk_read_header
+    lda hdr_error
+    beq @gotid
+@idnext:
+    dec dsk_tries
+    bne @idtry
+@nohdr:
+    jsr job_restore_zp
+    jmp @fail
+@gotid:
+    lda HEADER_BUF+5
+    sta want_id1
+    lda HEADER_BUF+4
+    sta want_id2
+    lda #<HDR_TPL
+    sta gcr_dst
+    lda #>HDR_TPL
+    sta gcr_dst+1
+    jsr disk_build_header
+    ldx #4
+@cp:
+    lda HDR_TPL,x
+    sta f50a_tpl,x
+    dex
+    bpl @cp
+    jsr job_restore_zp
+    lda #MAX_TRIES
+    sta f50a_tries
+@try:
+    jsr disk_wait_sync
+    bcs @fail
+    jsr disk_read10
+    ldx #4
+@cmp:
+    lda RAW_BUF,x
+    cmp f50a_tpl,x
+    bne @next
+    dex
+    bpl @cmp
+@data:
+    bit VIA2_PB                 ; the data block's SYNC
+    bmi @data
+    clv
+    ;  (breadbin) and Y = 0, as on a 1541: the caller stores the block with
+    ;  STA ($30),Y / INY from there (Creatures II's NOSDOS V1.8 reads each
+    ;  sector this way; Y left at 10 shifted every block by 10 bytes)
+    ldy #$00
+    rts
+@next:
+    dec f50a_tries
+    bne @try
+@fail:
+    lda #$02                    ; header not found: the job ends with 20
+    jmp compat_f969
+
+;  compat_d042: initialise the drive as the 1541's "I" does for code started
+;  by M-E (Krill's loader calls it): the head to track 18; the disk ID into
+;  $12/$13, the header read into $16-$1A (ID, track, sector, checksum) and
+;  the head's track into $22, where loaders compare and step from.
+compat_d042:
+    jsr job_save_zp
+    lda #18
+    sta want_track
+    lda JOB_TRACK
+    beq @find
+    sta cur_track
+@find:
+    jsr disk_find_current_track
+    jsr disk_seek
+    jsr disk_set_speed_zone
+    jsr disk_read_hdr_retry
+    lda cur_track
+    sta JOB_TRACK
+    jsr job_restore_zp
+    lda HEADER_BUF+5
+    sta $12
+    sta $16
+    lda HEADER_BUF+4
+    sta $13
+    sta $17
+    lda HEADER_BUF+3
+    sta $18
+    lda HEADER_BUF+2
+    sta $19
+    lda HEADER_BUF+1
+    sta $1A
+    lda #$01
+    rts
+
+;  compat_d586: read the sector of job $F9 into its buffer and wait for it,
+;  for code started by M-E (Spindle's bootstrap reads the rest of its drive
+;  code this way). Returns the job's result in A.
+compat_d586:
+    ldx $F9
+    lda #$80
+    sta $00,x
+    cli
+@wait:
+    lda $00,x
+    bmi @wait
+    rts
+
+;  compat_f969: end the running job with the result in A, back to the queue.
+compat_f969:
+    ldx JOB_SP
+    txs
+    jmp job_scan_resume
+
+;  The entry points below were added for Creatures II's crack loader, NOSDOS
+;  V1.8 by Nostalgia, which detects a 1541 and then runs its own reader as
+;  EXECUTE jobs (see its notes in tools/drive/README.md).
+
+;  compat_f418: end the running job with OK (result 1), as drive code does
+;  when its EXECUTE job is done (NOSDOS V1.8, after scanning or reading a track).
+compat_f418:
+    lda #$01
+    jmp compat_f969
+
+;  compat_c194: end the command in progress with "00, OK", for code started by
+;  M-E that ends with JMP $C194 instead of RTS (NOSDOS V1.8's first stage, once
+;  it has left its reader in the stack page). Back where cmd_me called it.
+compat_c194:
+    ldx me_sp
+    txs
+    jmp me_done
+
+;  compat_f556: wait for a SYNC mark on the disk, from a job (NOSDOS V1.8 reads
+;  each header and the start of each data block after one). Returns with the
+;  read latch cleared (LDA $1C01, CLV), so the next byte ready is the first
+;  after the SYNC, and Y = 0; X is kept. No SYNC for long: the job ends with 21.
+compat_f556:
+    txa
+    pha
+    ldx #$00
+    ldy #$00
+@w:
+    bit VIA2_PB
+    bpl @sync                   ; bit 7 = 0: SYNC
+    iny
+    bne @w
+    inx
+    bne @w
+    pla
+    lda #$03                    ; no SYNC: error 21
+    jmp compat_f969
+@sync:
+    pla
+    tax
+    lda VIA2_PA
+    clv
+    ldy #$00
+    rts
+
+;  compat_f7e8: decode the 5 GCR bytes at ($30),Y into 4 bytes at $52-$55 and
+;  leave Y past them (Y+5); X is kept. NOSDOS V1.8 decodes a header (ID mark,
+;  checksum, sector, track) and the first bytes of a data block (data mark,
+;  the link to the next block) this way. The 8 five-bit codes come off the
+;  top of the 40 bits in turn and go through the decode tables at $F8A0
+;  (high nibble) and $F8C0 (low nibble).
+GCR_HI = $F8A0
+GCR_LO = $F8C0
+compat_f7e8:
+    txa
+    pha
+    ldx #$00
+@ld:
+    lda ($30),y
+    sta f7e8_buf,x
+    iny
+    inx
+    cpx #5
+    bne @ld
+    tya
+    pha
+    ldx #$00                    ; the byte being made, $52+X
+    lda #8
+    sta f7e8_n
+@code:
+    lda #$00
+    sta f7e8_code
+    ldy #5
+@bit:
+    asl f7e8_buf+4
+    rol f7e8_buf+3
+    rol f7e8_buf+2
+    rol f7e8_buf+1
+    rol f7e8_buf+0
+    rol f7e8_code
+    dey
+    bne @bit
+    ldy f7e8_code
+    lda f7e8_n
+    lsr a                       ; 8, 6, 4, 2 codes left: a high nibble
+    bcs @lo
+    lda GCR_HI,y
+    sta $52,x
+    bcc @next                   ; (carry still clear)
+@lo:
+    lda GCR_LO,y
+    ora $52,x
+    sta $52,x
+    inx
+@next:
+    dec f7e8_n
+    bne @code
+    pla
+    tay
+    pla
+    tax
+    rts
+
+job_save_zp:
+    ldx #JOB_ZPLEN - 1
+@l:
+    lda JOB_ZP,x
+    sta JOB_SAVE,x
+    dex
+    bpl @l
+    rts
+
+job_restore_zp:
+    ldx #JOB_ZPLEN - 1
+@l:
+    lda JOB_SAVE,x
+    sta JOB_ZP,x
+    dex
+    bpl @l
+    rts
+
+;  job_run: job n (X) with the DOS's zero page; returns the result in A.
+job_run:
+    lda $00,x
+    and #$F0
+    cmp #$80
+    beq job_read
+    cmp #$B0
+    bne @ok
+    jsr job_head                ; SEEK
+@ok:
+    lda #$01
+    rts
+
+;  job_head: the head to job n's track (X), motor on.
+job_head:
+    txa
+    asl a
+    tay
+    lda $0006,y
+    sta want_track
+    lda $0007,y
+    sta want_sector
+    lda JOB_TRACK
+    beq @find
+    sta cur_track
+@find:
+    jsr disk_find_current_track
+job_reseek:
+    jsr disk_seek
+    jsr disk_set_speed_zone
+    lda cur_track
+    sta JOB_TRACK
+    rts
+
+;  job_read: job n's sector into buffer n, decoded in place (the data block's
+;  GCR is read into the buffer, the 69 bytes beyond it into JOB_OVF).
+job_read:
+    stx job_n
+    jsr job_head
+    lda #$00
+    sta dsk_ptr
+    lda job_n
+    clc
+    adc #$03
+    sta dsk_ptr+1
+    lda #MAX_TRIES
+    sta dsk_tries
+@try:
+    jsr disk_wait_sync
+    bcs @fail
+    jsr disk_read10
+    lda RAW_BUF
+    cmp #$52                    ; a header's first GCR byte
+    bne @next
+    jsr disk_wait_sync
+    bcs @fail
+    jsr job_read_block
+    lda #<RAW_BUF
+    sta gcr_src
+    lda #>RAW_BUF
+    sta gcr_src+1
+    jsr disk_read_header
+    lda hdr_error
+    bne @next
+    lda hdr_track
+    cmp want_track
+    beq @track
+    sta cur_track               ; the head is elsewhere: go again
+    jsr job_reseek
+    jmp @next
+@track:
+    lda hdr_sector
+    cmp want_sector
+    bne @next
+    jsr job_decode
+    lda data_error
+    bne @bad
+    lda #$01
+    rts
+@next:
+    dec dsk_tries
+    bne @try
+@fail:
+    lda #$02
+    rts
+@bad:
+    lda #$05
+    rts
+
+job_read_block:
+    ldy #$00
+    clv
+@r1:
+    bvc @r1
+    clv
+    lda VIA2_PA
+    sta (dsk_ptr),y
+    iny
+    bne @r1
+    ldy #$00
+@r2:
+    bvc @r2
+    clv
+    lda VIA2_PA
+    sta JOB_OVF,y
+    iny
+    cpy #(325-256)
+    bne @r2
+    rts
+
+;  job_decode: 65 groups of 5 GCR bytes -> the data mark, 256 bytes into the
+;  buffer and the checksum. The output trails the input, so in place is safe.
+job_decode:
+    lda #$00
+    sta job_si
+    sta job_si+1
+    sta job_k
+    sta job_k+1
+    sta dsk_csum
+    lda #65
+    sta dsk_count
+@group:
+    ldx #$00
+@ld:
+    jsr job_get
+    sta gcr_o,x
+    inx
+    cpx #5
+    bne @ld
+    lda #4
+    sta job_j
+@out:
+    jsr gcr_get_nibble
+    asl a
+    asl a
+    asl a
+    asl a
+    sta gcr_tmp
+    jsr gcr_get_nibble
+    ora gcr_tmp
+    jsr job_emit
+    dec job_j
+    bne @out
+    dec dsk_count
+    bne @group
+    lda job_mark
+    cmp #DATA_MARK
+    bne @bad
+    lda dsk_csum
+    cmp job_sum
+    bne @bad
+    lda #$00
+    sta data_error
+    rts
+@bad:
+    lda #$FF
+    sta data_error
+    rts
+
+job_get:
+    ldy job_si
+    lda job_si+1
+    bne @ovf
+    lda (dsk_ptr),y
+    jmp @inc
+@ovf:
+    lda JOB_OVF,y
+@inc:
+    inc job_si
+    bne @r
+    inc job_si+1
+@r:
+    rts
+
+job_emit:
+    sta job_byte
+    lda job_k+1
+    bne @hi
+    lda job_k
+    beq @mark
+    tay
+    dey
+    lda job_byte
+    sta (dsk_ptr),y
+    eor dsk_csum
+    sta dsk_csum
+    jmp @inc
+@mark:
+    lda job_byte
+    sta job_mark
+    jmp @inc
+@hi:
+    lda job_k
+    bne @sum
+    ldy #$FF                    ; byte 256: the buffer's last
+    lda job_byte
+    sta (dsk_ptr),y
+    eor dsk_csum
+    sta dsk_csum
+    jmp @inc
+@sum:
+    cmp #1
+    bne @inc
+    lda job_byte
+    sta job_sum
+@inc:
+    inc job_k
+    bne @r
+    inc job_k+1
+@r:
+    rts
+
 .segment "RODATA"
 TX_BUF: .byte $11, $22, $33
 
@@ -4841,6 +5760,63 @@ msg_illegal:   .byte "ILLEGAL TRACK OR SECTOR", 0
 msg_dosid:     .byte "PASCUAL DOS 1541", 0
 msg_generic:   .byte "ERROR", 0
 
+.segment "D042"
+    jmp compat_d042
+.segment "D586"
+    jmp compat_d586
+;  The drive model where loaders look for it, so they take this for the 1541
+;  it stands in for. On a 1541 it is the end of the power-on message in the
+;  DOS's message table, "...1541", whose last character carries bit 7 as
+;  every entry's does: M-R $E5C6 reads "4", $B1. Creatures II's crack loader
+;  (NOSDOS V1.8) compares exactly those two bytes to tell a 1541 from a 1570,
+;  1571, 1581 or CMD drive, and stops with "DRIVE ERROR!" on anything else.
+.segment "E5C4"
+    .byte "154", '1' | $80
+;  NOSDOS V1.8 (Creatures II's crack loader) reads one byte at $FEA0 before
+;  the model text: $0D on a 1541 sends it to "1541" at $E5C6; other values
+;  stand for the 1571, 1581 and CMD drives, whose model text it looks for
+;  elsewhere ($FEA4, $A6E9, $FEA3). Erased ROM ($FF) took this for a 1581,
+;  found no 1581 there and stopped with "DRIVE ERROR!".
+.segment "FEA0"
+    .byte $0D
+.segment "C194"
+    jmp compat_c194
+;  The 1541's reset routine is at $EAA0: programs reset the drive with
+;  M-E $EAA0, and VirtualC64 (vc64web) starts the drive's CPU there itself
+;  instead of reading the reset vector. Without this the drive ran through
+;  erased ROM ($FF) from $EAA0 into whatever code came next, and once the
+;  entry points below were in its way (Creatures II), jammed at power-on.
+.segment "EAA0"
+    jmp reset
+.segment "F418"
+    jmp compat_f418
+.segment "F50A"
+    jmp compat_f50a
+.segment "F556"
+    jmp compat_f556
+;  NOSDOS V1.8 (Creatures II) copies 100 bytes from $F575 to $0146 and ends
+;  them with an RTS: on a 1541 the ROM's routine that writes a data block,
+;  which its high score saver calls. This DOS has none to give, so the copy is
+;  an RTS that returns at once: the high scores stay in memory and the game
+;  goes on (in the browser a disk write would not outlive the visit anyway).
+.segment "F575"
+    rts
+.segment "F7E8"
+    jmp compat_f7e8
+.segment "F969"
+    jmp compat_f969
+;  The GCR decode tables at the addresses fast loaders read them from: code
+;  (0-31) -> high nibble, and -> low nibble; $FF for codes that aren't GCR.
+.segment "GCRTAB"
+    .byte $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
+    .byte $FF,$80,$00,$10,$FF,$C0,$40,$50
+    .byte $FF,$FF,$20,$30,$FF,$F0,$60,$70
+    .byte $FF,$90,$A0,$B0,$FF,$D0,$E0,$FF
+    .byte $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
+    .byte $FF,$08,$00,$01,$FF,$0C,$04,$05
+    .byte $FF,$FF,$02,$03,$FF,$0F,$06,$07
+    .byte $FF,$09,$0A,$0B,$FF,$0D,$0E,$FF
+
 .segment "VECTORS"
     .word nmi
     .word reset
